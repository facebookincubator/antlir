[cells]
    antlir = .
    prelude = prelude
    toolchains = toolchains
    none = none

[cell_aliases]
    config = prelude
    ovr_config = prelude
    fbcode = none
    fbsource = none
    fbcode_macros = none
    buck = none
    # .buckconfig.d/common.buckconfig (shipped by add_buck2_support) aliases
    # `toolchains` at the shim cell. Antlir has its own toolchains cell, so
    # re-assert it here -- .buckconfig takes precedence over .buckconfig.d.
    toolchains = toolchains

[external_cells]
    prelude = bundled

[parser]
    target_platform_detector_spec = target:antlir//...->prelude//platforms:default target:shim//...->prelude//platforms:default

[project]
    ignore = antlir2-out, .git, .sl

[buck2]
    file_watcher = watchman

[build]
    execution_platforms = antlir//platforms:host
