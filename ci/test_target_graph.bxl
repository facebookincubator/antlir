def _impl(ctx):
    targets = ctx.uquery().eval("set(//...)")

    ctx.output.print("All BUCK files evaluate ({} targets)".format(len(targets)))

    if ctx.cli_args.eval_only:
        return

    targets = ctx.configured_targets(targets)

    ctx.output.print("All targets configure successfully")

    ctx.analysis(targets)

    ctx.output.print("All targets analyze successfully")

test_target_graph = bxl_main(
    impl = _impl,
    cli_args = {
        "eval_only": cli_args.bool(
            default = False,
            doc = "Only evaluate the target graph, skipping configuration and analysis (for environments where third-party deps are not vendored)",
        ),
    },
)
