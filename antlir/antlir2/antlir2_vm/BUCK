load("//antlir/antlir2/bzl:platform.bzl", "arch_select")
load("//antlir/antlir2/bzl/feature:defs.bzl", "feature")
load("//antlir/antlir2/bzl/image:defs.bzl", "image")
load("//antlir/antlir2/bzl/package:defs.bzl", "package")
load("//antlir/bzl:build_defs.bzl", "buck_command_alias", "python_binary", "rust_binary")

oncall("antlir")

rust_binary(
    name = "antlir2_vm",
    srcs = glob(["src/**/*.rs"]),
    mapped_srcs = {
        "//antlir/linux/vm/ssh:privkey": "src/ssh/privkey",
    },
    visibility = ["PUBLIC"],
    deps = [
        "anyhow",
        "clap",
        "derive_builder",
        "maplit",
        "nonempty",
        "serde",
        "serde_json",
        "tempfile",
        "thiserror",
        "tracing",
        "tracing-subscriber",
        "uuid",
        "//antlir:find_root",
        "//antlir/antlir2/antlir2_isolate:antlir2_isolate",
        "//antlir/antlir2/antlir2_rootless:antlir2_rootless",
        "//antlir/antlir2/testing/image_test:image_test_lib",
        "//antlir/util/cli/json_arg:json_arg",
    ],
)

feature.new(
    name = "vm-firmwares",
    features = [
        feature.rpms_install(
            rpms = [
                "edk2-ovmf",
                "edk2-aarch64",
            ]
        ),
        # QEMU aarch64 expects the firmware to be exactly 64M, but the edk2
        # firwmare for aarch64 is not padded, so just extend it during the image
        # build instead of at runtime
        feature.genrule(
            bash = """
                truncate -s 64M /usr/share/edk2/aarch64/QEMU_EFI.fd
            """,
            user = "root",
        ),
    ],
)

# We isolate VM inside a container. This is the image layer for the container
# with tools we need for VM tests.
image.layer(
    name = "container-image",
    default_os = "centos10",
    dnf_versionlock_extend = {
        # This is the same hyperscale version used for qemu-common, ensure that
        # qemu-kvm-common is covered too
        "qemu-kvm-common": "10.1.2-1.4.hs+fb.el10"
    },
    features = [
        feature.rpms_install(
            rpms = [
                "fb-xarexec",  # for @mode/opt python tests @oss-disable
                "glib2",  # for qemu-img
                "iproute",  # for NIC configuration
                "numactl-libs",  # for qemu-system
                "openssh-clients",  # for ssh shell
                "qemu-img",  # manipulate disk images
                "systemd-container",  # for systemd-detect-virt
                "virtiofsd",  # rust virtiofsd
                "scsi-target-utils",  # host iscsi targets
            ]
        ),
        # The qemu-system emulator to run a VM. On x86_64 we also install the
        # aarch64 emulator since aarch64 VM tests are executed on x86_64 hosts.
        # On aarch64 we only install the native emulator: qemu-system-x86 there
        # pulls in qemu-system-x86-core, whose seabios-bin/seavgabios-bin deps
        # aren't published in the aarch64 repos, and x86-on-aarch64 emulation is
        # not currently used.
        feature.rpms_install(
            subjects = arch_select(
                aarch64 = ["qemu-system-aarch64"],
                x86_64 = ["qemu-system-x86", "qemu-system-aarch64"],
            ),
        ),
        # Don't let random configurations sneak in - we want this tightly
        # controlled since it's a very constrained environment and a somewhat
        # unique setup to just SSH into the local VM
        feature.remove(path = "/etc/ssh/ssh_config.d"),
        feature.ensure_dirs_exist(dirs = "/antlir"),
        ":vm-firmwares",
    ],
    visibility = [],
)

package.unprivileged_dir(
    name = "container-dir",
    # systemd >= 259 ships templated units (e.g. systemd-mute-console@.service)
    # whose auto-created slice directories have systemd-escaped names containing
    # literal backslashes (e.g. `system-systemd\x2dmute\x2dconsole.slice`).
    # buck2's FileName validation rejects backslashes when collecting this dir's
    # outputs ("slashes in path"), failing the build. Base64-encode such names
    # so they are legal in buck-out. The container is launched via unshare() and
    # never boots systemd, so these inert unit files are never read by name.
    base64_encode_filenames = True,
    default_os = "centos10",
    layer = ":container-image",
    visibility = ["PUBLIC"],
)

python_binary(
    name = "static-list",
    srcs = ["static_list.py"],
    main_module = "antlir.antlir2.antlir2_vm.static_list",
)

buck_command_alias(
    name = "static-list-cpp",
    args = ["cpp"],
    exe = ":static-list",
    visibility = ["PUBLIC"],
)

buck_command_alias(
    name = "static-list-py",
    args = ["py"],
    exe = ":static-list",
    visibility = ["PUBLIC"],
)

buck_command_alias(
    name = "static-list-rust",
    args = ["rust"],
    exe = ":static-list",
    visibility = ["PUBLIC"],
)
