load("//antlir/antlir2/bzl:configured_alias.bzl", "antlir2_configured_alias")
load("//antlir/antlir2/bzl/feature:defs.bzl", "feature")
load("//antlir/antlir2/bzl/image:defs.bzl", "image")
load("//antlir/antlir2/package_managers/deb:local_suite.bzl", "local_suite")
load("//antlir/antlir2/testing:image_debs_test.bzl", "image_test_deb_names")
load("//antlir/antlir2/testing:image_test.bzl", "image_sh_test")
load(":defs.bzl", "test_deb")

oncall("antlir")

image.layer(
    name = "bash-installed",
    default_os = "debian-trixie",
    features = [
        feature.apt_install(
            packages = [
                "bash",
                "dash",
                "dpkg",
            ]
        ),
    ],
)

image_test_deb_names(
    name = "test-bash-installed",
    layer = ":bash-installed",
    names = [
        "bash",
        "dash",
        "dpkg",
    ],
)

antlir2_configured_alias(
    name = "test-bash-installed-ubuntu-noble",
    actual = ":test-bash-installed",
    default_os = "ubuntu-noble",
    # Noble does not have aarch64 packages
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

image.layer(
    name = "bash-removed",
    default_os = "debian-trixie",
    features = [
        feature.apt_remove(
            packages = [
                "bash",
            ]
        ),
    ],
    parent_layer = ":bash-installed",
)

image_test_deb_names(
    name = "test-bash-removed",
    layer = ":bash-removed",
    names = [
        "bash",
    ],
    not_installed = True,
)

# The suite seeds the debootstrap base set (Essential + Required) into
# every installing transaction. None of login, hostname or perl-base is
# requested here or depended on by bash, dash or dpkg, so their presence
# proves the seeding.
image_test_deb_names(
    name = "test-base-seeded",
    layer = ":bash-installed",
    names = [
        "hostname",
        "login",
        "perl-base",
    ],
)

antlir2_configured_alias(
    name = "test-base-seeded-ubuntu-noble",
    actual = ":test-base-seeded",
    default_os = "ubuntu-noble",
    # Noble does not have aarch64 packages
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

# base-files creates the merged-/usr alias symlinks (/bin, /sbin, /lib,
# /lib64 -> usr/*). iproute2 still ships legacy paths, so installing it in a
# child layer must leave the symlinks intact with its files merged through.
image.layer(
    name = "usrmerge-base",
    default_os = "debian-trixie",
    features = [
        feature.apt_install(
            packages = [
                "bash",
                "coreutils",
                "dash",
            ]
        ),
    ],
)

image.layer(
    name = "usrmerge-child",
    default_os = "debian-trixie",
    features = [
        feature.apt_install(
            packages = [
                "iproute2",
            ]
        ),
    ],
    parent_layer = ":usrmerge-base",
)

image_sh_test(
    name = "test-usrmerge",
    layer = ":usrmerge-child",
    test = "test-usrmerge.sh",
)

antlir2_configured_alias(
    name = "test-usrmerge-ubuntu-noble",
    actual = ":test-usrmerge",
    default_os = "ubuntu-noble",
    # Noble does not have aarch64 packages
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

local_suite(
    name = "test-suite",
    debs = [
        test_deb(
            name = "antlir2-files",
            features = [
                feature.ensure_dirs_exist(dirs = "/antlir2-files/dir"),
                feature.ensure_dirs_exist(dirs = "/antlir2-files/empty-dir"),
                feature.install_text(
                    dst = "/antlir2-files/dir/file",
                    text = "hello\n",
                ),
                feature.install_text(
                    dst = "/antlir2-files/dir/executable",
                    mode = "a+rx",
                    text = "#!/bin/sh\n",
                ),
                feature.ensure_file_symlink(
                    link = "/antlir2-files/symlink",
                    target = "/antlir2-files/dir/file",
                ),
            ],
            summary = "antlir2 test package with files and directories",
            version = "1",
        ),
        test_deb(
            name = "antlir2-scripts",
            postinst = 'echo "$@" > /antlir2-postinst-ran',
            postrm = 'echo "$@" > /antlir2-postrm-ran',
            preinst = 'echo "$@" > /antlir2-preinst-ran',
            prerm = 'echo "$@" > /antlir2-prerm-ran',
            version = "1",
        ),
        # Registers itself as an alternative the same way that
        # dh_installalternatives does for real packages
        test_deb(
            name = "antlir2-alternative",
            features = [
                feature.ensure_dirs_exist(dirs = "/usr/bin"),
                feature.install_text(
                    dst = "/usr/bin/antlir2-greeter-hello",
                    mode = "a+rx",
                    text = "#!/bin/sh\necho hello from antlir2\n",
                ),
            ],
            postinst = """
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
    update-alternatives --install /usr/bin/antlir2-greeter antlir2-greeter /usr/bin/antlir2-greeter-hello 5 \\
        --slave /usr/bin/antlir2-greet antlir2-greet /usr/bin/antlir2-greeter-hello
fi
""",
            prerm = """
if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    update-alternatives --remove antlir2-greeter /usr/bin/antlir2-greeter-hello
fi
""",
            version = "1",
        ),
    ],
)

image.layer(
    name = "local-debs-installed",
    features = [
        feature.apt_install(
            packages = [
                "antlir2-alternative",
                "antlir2-files",
                "antlir2-scripts",
            ],
            suite = ":test-suite",
        ),
    ],
    parent_layer = ":bash-installed",
)

image_test_deb_names(
    name = "test-local-debs-installed",
    layer = ":local-debs-installed",
    names = [
        "antlir2-alternative",
        "antlir2-files",
        "antlir2-scripts",
    ],
)

image_sh_test(
    name = "test-local-deb-alternative-installed",
    layer = ":local-debs-installed",
    test = "test-local-deb-alternative-installed.sh",
)

image_sh_test(
    name = "test-local-deb-files",
    layer = ":local-debs-installed",
    test = "test-local-deb-files.sh",
)

image_sh_test(
    name = "test-local-deb-install-scripts-run",
    layer = ":local-debs-installed",
    test = "test-local-deb-install-scripts-run.sh",
)

image.layer(
    name = "local-deb-scripts-removed",
    features = [
        feature.apt_remove(
            packages = [
                "antlir2-alternative",
                "antlir2-scripts",
            ]
        ),
    ],
    parent_layer = ":local-debs-installed",
)

image_sh_test(
    name = "test-local-deb-remove-scripts-run",
    layer = ":local-deb-scripts-removed",
    test = "test-local-deb-remove-scripts-run.sh",
)

image_sh_test(
    name = "test-local-deb-alternative-removed",
    layer = ":local-deb-scripts-removed",
    test = "test-local-deb-alternative-removed.sh",
)

image_sh_test(
    name = "test-dpkg-status-unique",
    layer = ":usrmerge-child",
    test = "test-dpkg-status-unique.sh",
)

antlir2_configured_alias(
    name = "test-dpkg-status-unique-ubuntu-noble",
    actual = ":test-dpkg-status-unique",
    default_os = "ubuntu-noble",
    # Noble does not have aarch64 packages
    target_compatible_with = ["ovr_config//cpu:x86_64"],
