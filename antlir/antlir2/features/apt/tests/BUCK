load("//antlir/antlir2/bzl:configured_alias.bzl", "antlir2_configured_alias")
load("//antlir/antlir2/bzl/feature:defs.bzl", "feature")
load("//antlir/antlir2/bzl/image:defs.bzl", "image")
load("//antlir/antlir2/testing:image_debs_test.bzl", "image_test_deb_names")
load("//antlir/antlir2/testing:image_test.bzl", "image_sh_test")

oncall("antlir")

image.layer(
    name = "bash-installed",
    default_os = "debian-trixie",
    features = [
        feature.apt_install(
            packages = [
                "bash",
                "dash",
                "dpkg",
            ]
        ),
    ],
)

image_test_deb_names(
    name = "test-bash-installed",
    layer = ":bash-installed",
    names = [
        "bash",
        "dash",
        "dpkg",
    ],
)

antlir2_configured_alias(
    name = "test-bash-installed-ubuntu-noble",
    actual = ":test-bash-installed",
    default_os = "ubuntu-noble",
    # Noble does not have aarch64 packages
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

image.layer(
    name = "bash-removed",
    default_os = "debian-trixie",
    features = [
        feature.apt_remove(
            packages = [
                "bash",
            ]
        ),
    ],
    parent_layer = ":bash-installed",
)

image_test_deb_names(
    name = "test-bash-removed",
    layer = ":bash-removed",
    names = [
        "bash",
    ],
    not_installed = True,
)

# The suite seeds the debootstrap base set (Essential + Required) into
# every installing transaction. None of login, hostname or perl-base is
# requested here or depended on by bash, dash or dpkg, so their presence
# proves the seeding.
image_test_deb_names(
    name = "test-base-seeded",
    layer = ":bash-installed",
    names = [
        "hostname",
        "login",
        "perl-base",
    ],
)

antlir2_configured_alias(
    name = "test-base-seeded-ubuntu-noble",
    actual = ":test-base-seeded",
    default_os = "ubuntu-noble",
    # Noble does not have aarch64 packages
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

# base-files creates the merged-/usr alias symlinks (/bin, /sbin, /lib,
# /lib64 -> usr/*). iproute2 still ships legacy paths, so installing it in a
# child layer must leave the symlinks intact with its files merged through.
image.layer(
    name = "usrmerge-base",
    default_os = "debian-trixie",
    features = [
        feature.apt_install(
            packages = [
                "bash",
                "coreutils",
                "dash",
            ]
        ),
    ],
)

image.layer(
    name = "usrmerge-child",
    default_os = "debian-trixie",
    features = [
        feature.apt_install(
            packages = [
                "iproute2",
            ]
        ),
    ],
    parent_layer = ":usrmerge-base",
)

image_sh_test(
    name = "test-usrmerge",
    layer = ":usrmerge-child",
    test = "test-usrmerge.sh",
)

antlir2_configured_alias(
    name = "test-usrmerge-ubuntu-noble",
    actual = ":test-usrmerge",
    default_os = "ubuntu-noble",
    # Noble does not have aarch64 packages
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)

image_sh_test(
    name = "test-dpkg-status-unique",
    layer = ":usrmerge-child",
    test = "test-dpkg-status-unique.sh",
)

antlir2_configured_alias(
    name = "test-dpkg-status-unique-ubuntu-noble",
    actual = ":test-dpkg-status-unique",
    default_os = "ubuntu-noble",
    # Noble does not have aarch64 packages
    target_compatible_with = ["ovr_config//cpu:x86_64"],
)
