)

# systemd Recommends systemd-timesyncd on every flavor; apt installs it unless
# the transaction opts out of Recommends.
image.layer(
    name = "systemd-with-recommends",
    features = [
        feature.apt_install(packages = ["systemd"]),
    ],
)

test_on_all_flavors(
    image_test_deb_names,
    name = "test-recommends-installed",
    layer = ":systemd-with-recommends",
    names = ["systemd-timesyncd"],
)

image.layer(
    name = "systemd-without-recommends",
    features = [
        feature.apt_install(
            install_recommends = False,
            packages = ["systemd"],
        ),
    ],
)

test_on_all_flavors(
    image_test_deb_names,
    name = "test-recommends-not-installed",
    layer = ":systemd-without-recommends",
    names = ["systemd-timesyncd"],
    not_installed = True,
)

# chrony's postinst runs ucf, which needs awk. Nothing chrony depends on pulls
# in mawk, so this only builds if the seeded Required packages (mawk among
# them) are configured before everything else.
image.layer(
    name = "chrony-installed",
    default_os = "debian-trixie",
    features = [
        feature.apt_install(packages = ["chrony"]),
    ],
)

test_on_all_flavors(
    image_test_deb_names,
    name = "test-required-configured-first",
    layer = ":chrony-installed",
    names = ["chrony"],
)

# Two distributions carrying different versions of one package, seen as one
# set of sources.
[
    local_suite(
        name = "versioned-v" + version,
        debs = [
            test_deb(
                name = "antlir2-versioned",
                features = [
                    feature.install_text(
                        dst = "/antlir2-versioned",
                        text = version + "\n",
                    ),
                ],
                version = version,
            ),
        ],
    )
    for version in ["1", "2"]
]

suite_set(
    name = "versioned",
    suites = [
        ":versioned-v1",
        ":versioned-v2",
    ],
)

# The newest version across the set wins, as apt does across sources, and
# each .deb comes from the suite it resolved from.
image.layer(
    name = "versioned-latest",
    features = [
        feature.apt_install(
            packages = ["antlir2-versioned"],
            suite = ":versioned",
        ),
    ],
    parent_layer = ":bash-installed",
)

test_on_all_flavors(
    image_sh_test,
    name = "test-suite-set-latest",
    env = {"VERSION": "2"},
    layer = ":versioned-latest",
    test = "test-versioned.sh",
)

image.layer(
    name = "versioned-pinned",
    features = [
        feature.apt_install(
            packages = ["antlir2-versioned=1"],
            suite = ":versioned",
        ),
    ],
    parent_layer = ":bash-installed",
)

test_on_all_flavors(
    image_sh_test,
    name = "test-version-pin",
    env = {"VERSION": "1"},
    layer = ":versioned-pinned",
    test = "test-versioned.sh",
)

# dpkg leaves out what the image's dpkg configuration excludes (as Ubuntu's
# minimized images and mkosi's WithDocs=no do), but still lists it
image.layer(
    name = "docs-excluded-config",
    features = [
        feature.install_text(
            dst = "/etc/dpkg/dpkg.cfg.d/excludes",
            text = """path-exclude=/usr/share/doc/*
path-include=/usr/share/doc/*/copyright
path-exclude /usr/share/man/*
""",
        ),
    ],
    parent_layer = ":bash-installed",
)

image.layer(
    name = "docs-excluded",
    features = [
        feature.apt_install(
            packages = ["antlir2-docs"],
            suite = ":test-suite",
        ),
    ],
    parent_layer = ":docs-excluded-config",
)

test_on_all_flavors(
    image_sh_test,
    name = "test-path-filters",
    layer = ":docs-excluded",
    test = "test-path-filters.sh",
)

# the owner's file lands at the diversion, whichever unpacks first
image.layer(
    name = "diverted",
    features = [
        feature.apt_install(
            packages = [
                "antlir2-diverted-owner",
                "antlir2-diverter",
            ],
            suite = ":test-suite",
        ),
    ],
    parent_layer = ":bash-installed",
)

test_on_all_flavors(
    image_sh_test,
    name = "test-diversion",
    layer = ":diverted",
    test = "test-diversion.sh",
)

suite_set(
    name = "default-and-test-suite",
    base_variant = "essential",
    suites = [":test-suite"] + select({
        "DEFAULT": [TRIXIE_SUITE],
        "antlir//antlir/antlir2/os:ubuntu-noble": [NOBLE_SUITE],
        "antlir//antlir/antlir2/os:ubuntu-stonking": [STONKING_SUITE],
    }),
)

# A new root is installed as debootstrap installs it: the Essential
# packages are configured before any other package is unpacked, and only
# their files are on disk before maintainer scripts run, so a package
# diverting a path it ships itself renames nothing in its preinst
image.layer(
    name = "self-diverted",
    features = [
        feature.apt_install(
            packages = [
                "antlir2-after-essential",
                "antlir2-diverter",
                "bash",
                "dash",
                "dpkg",
            ],
            suite = ":default-and-test-suite",
        ),
    ],
)

test_on_all_flavors(
    image_sh_test,
    name = "test-self-diversion",
    layer = ":self-diverted",
    test = "test-self-diversion.sh",
)

# the dpkg database records what dpkg would: every path a package ships, and
# the md5sum of each conffile as unpacked
test_on_all_flavors(
    image_sh_test,
    name = "test-dpkg-database",
    layer = ":systemd-without-recommends",
    test = "test-dpkg-database.sh",
)
