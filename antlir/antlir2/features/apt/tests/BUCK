load("//antlir/antlir2/bzl/feature:defs.bzl", "feature")
load("//antlir/antlir2/bzl/image:defs.bzl", "image")
load("//antlir/antlir2/features/apt:apt.bzl", "NOBLE_SUITE", "STONKING_SUITE", "TRIXIE_SUITE")
load("//antlir/antlir2/package_managers/deb:local_suite.bzl", "local_suite")
load("//antlir/antlir2/package_managers/deb:suite_set.bzl", "suite_set")
load("//antlir/antlir2/testing:image_debs_test.bzl", "image_test_deb_names")
load("//antlir/antlir2/testing:image_test.bzl", "image_sh_test")
load(":defs.bzl", "test_deb", "test_on_all_flavors")

oncall("antlir")

image.layer(
    name = "bash-installed",
    default_os = "debian-trixie",
    features = [
        feature.apt_install(
            packages = [
                "bash",
                "dash",
                "dpkg",
            ]
        ),
    ],
)

test_on_all_flavors(
    image_test_deb_names,
    name = "test-bash-installed",
    layer = ":bash-installed",
    names = [
        "bash",
        "dash",
        "dpkg",
    ],
)

image.layer(
    name = "bash-removed",
    default_os = "debian-trixie",
    features = [
        feature.apt_remove(
            packages = [
                "bash",
            ]
        ),
    ],
    parent_layer = ":bash-installed",
)

test_on_all_flavors(
    image_test_deb_names,
    name = "test-bash-removed",
    layer = ":bash-removed",
    names = [
        "bash",
    ],
    not_installed = True,
)

# The suite seeds the debootstrap base set (Essential + Required) into
# every installing transaction. None of login, hostname or perl-base is
# requested here or depended on by bash, dash or dpkg, so their presence
# proves the seeding.
test_on_all_flavors(
    image_test_deb_names,
    name = "test-base-seeded",
    layer = ":bash-installed",
    names = [
        "hostname",
        "login",
        "perl-base",
    ],
)

# base-files creates the merged-/usr alias symlinks (/bin, /sbin, /lib,
# /lib64 -> usr/*). iproute2 still ships legacy paths, so installing it in a
# child layer must leave the symlinks intact with its files merged through.
image.layer(
    name = "usrmerge-base",
    default_os = "debian-trixie",
    features = [
        feature.apt_install(
            packages = [
                "bash",
                "coreutils",
                "dash",
            ]
        ),
    ],
)

image.layer(
    name = "usrmerge-child",
    default_os = "debian-trixie",
    features = [
        feature.apt_install(
            packages = [
                "iproute2",
            ]
        ),
    ],
    parent_layer = ":usrmerge-base",
)

test_on_all_flavors(
    image_sh_test,
    name = "test-usrmerge",
    layer = ":usrmerge-child",
    test = "test-usrmerge.sh",
)

local_suite(
    name = "test-suite",
    debs = [
        test_deb(
            name = "antlir2-files",
            features = [
                feature.ensure_dirs_exist(dirs = "/antlir2-files/dir"),
                feature.ensure_dirs_exist(dirs = "/antlir2-files/empty-dir"),
                feature.install_text(
                    dst = "/antlir2-files/dir/file",
                    text = "hello\n",
                ),
                feature.install_text(
                    dst = "/antlir2-files/dir/executable",
                    mode = "a+rx",
                    text = "#!/bin/sh\n",
                ),
                feature.ensure_file_symlink(
                    link = "/antlir2-files/symlink",
                    target = "/antlir2-files/dir/file",
                ),
            ],
            summary = "antlir2 test package with files and directories",
            version = "1",
        ),
        test_deb(
            name = "antlir2-scripts",
            postinst = 'echo "$@" > /antlir2-postinst-ran; echo "$SOURCE_DATE_EPOCH" > /antlir2-postinst-epoch',
            postrm = 'echo "$@" > /antlir2-postrm-ran; echo "$SOURCE_DATE_EPOCH" > /antlir2-postrm-epoch',
            preinst = 'echo "$@" > /antlir2-preinst-ran; echo "$SOURCE_DATE_EPOCH" > /antlir2-preinst-epoch',
            prerm = 'echo "$@" > /antlir2-prerm-ran; echo "$SOURCE_DATE_EPOCH" > /antlir2-prerm-epoch',
            version = "1",
        ),
        test_deb(
            name = "antlir2-docs",
            features = [
                feature.ensure_dirs_exist(dirs = "/usr/share/doc/antlir2-docs"),
                feature.ensure_dirs_exist(dirs = "/usr/share/man/man1"),
                feature.install_text(
                    dst = "/usr/share/doc/antlir2-docs/README",
                    text = "readme\n",
                ),
                feature.install_text(
                    dst = "/usr/share/doc/antlir2-docs/copyright",
                    text = "copyright\n",
                ),
                feature.install_text(
                    dst = "/usr/share/man/man1/antlir2-docs.1",
                    text = "manual\n",
                ),
            ],
            version = "1",
        ),
        # Diverts /antlir2-diverted and /etc/antlir2-diverted.conf, which
        # antlir2-diverted-owner also ships, the way packages that replace
        # another's file do
        test_deb(
            name = "antlir2-diverter",
            features = [
                feature.install_text(
                    dst = "/antlir2-diverted",
                    text = "diverter\n",
                ),
                feature.ensure_dirs_exist(dirs = "/etc"),
                feature.install_text(
                    dst = "/etc/antlir2-diverted.conf",
                    text = "diverter\n",
                ),
            ],
            preinst = """
dpkg-divert --package antlir2-diverter --add --rename --divert /antlir2-diverted.distrib /antlir2-diverted
dpkg-divert --package antlir2-diverter --add --rename --divert /etc/antlir2-diverted.conf.distrib /etc/antlir2-diverted.conf
""",
            version = "1",
        ),
        # Records, before it is unpacked, whether libc-bin's postinst (which
        # runs ldconfig) has run
        test_deb(
            name = "antlir2-after-essential",
            preinst = "if [ -e /etc/ld.so.cache ]; then echo configured; else echo unconfigured; fi > /antlir2-libc-bin-status",
            version = "1",
        ),
        # Unpacked after the diverter (Pre-Depends), with a hard link to its
        # diverted file and a diverted conffile
        test_deb(
            name = "antlir2-diverted-owner",
            features = [
                feature.install_text(
                    dst = "/antlir2-diverted",
                    text = "owner\n",
                ),
                feature.hardlink(
                    link = "/antlir2-diverted-link",
                    target = "/antlir2-diverted",
                ),
                feature.ensure_dirs_exist(dirs = "/etc"),
                feature.install_text(
                    dst = "/etc/antlir2-diverted.conf",
                    text = "owner\n",
                ),
                feature.ensure_dirs_exist(dirs = "/DEBIAN"),
                feature.install_text(
                    dst = "/DEBIAN/conffiles",
                    text = "/etc/antlir2-diverted.conf\n",
                ),
            ],
            pre_depends = ["antlir2-diverter"],
            version = "1",
        ),
        # Registers itself as an alternative the same way that
        # dh_installalternatives does for real packages
        test_deb(
            name = "antlir2-alternative",
            features = [
                feature.ensure_dirs_exist(dirs = "/usr/bin"),
                feature.install_text(
                    dst = "/usr/bin/antlir2-greeter-hello",
                    mode = "a+rx",
                    text = "#!/bin/sh\necho hello from antlir2\n",
                ),
            ],
            postinst = """
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
    update-alternatives --install /usr/bin/antlir2-greeter antlir2-greeter /usr/bin/antlir2-greeter-hello 5 \\
        --slave /usr/bin/antlir2-greet antlir2-greet /usr/bin/antlir2-greeter-hello
fi
""",
            prerm = """
if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
    update-alternatives --remove antlir2-greeter /usr/bin/antlir2-greeter-hello
fi
""",
            version = "1",
        ),
    ],
)

image.layer(
    name = "local-debs-installed",
    features = [
        feature.apt_install(
            packages = [
                "antlir2-alternative",
                "antlir2-files",
                "antlir2-scripts",
            ],
            suite = ":test-suite",
        ),
    ],
    parent_layer = ":bash-installed",
)

