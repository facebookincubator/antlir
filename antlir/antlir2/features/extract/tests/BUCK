load("//antlir/antlir2/bzl/feature:defs.bzl", "feature")
load("//antlir/antlir2/bzl/image:defs.bzl", "image")
load("//antlir/antlir2/testing:image_test.bzl", "image_sh_test")
load("//antlir/bzl:build_defs.bzl", "rust_binary")
load("//antlir/bzl:internal_external.bzl", "internal_external")
load(":defs.bzl", "library_path")

oncall("antlir")

image.layer(
    name = "base",
    features = [
        # dependencies of the test
        feature.package_install(
            subjects = [
                "bash",
                "util-linux",
            ]
        ),
    ],
)

rust_binary(
    name = "binary_1",
    srcs = ["main.rs"],
    unittests = False,
)

rust_binary(
    name = "binary_2",
    srcs = ["main.rs"],
    unittests = False,
)

image.layer(
    name = "extract-buck",
    features = [
        feature.ensure_dirs_exist(dirs = "/usr/bin"),
        feature.extract_buck_binary(
            src = ":binary_1",
            dst = "/usr/bin/test-binary-extracted",
        ),
    ],
    parent_layer = ":base",
)

image_sh_test(
    name = "extract-buck-test",
    env = {"ANTLIR_TEST_FACEBOOK": internal_external(fb = "1", oss = "0")},
    layer = ":extract-buck",
    test = "test-extract-buck.sh",
)

image.layer(
    name = "binaries-clone-src",
    features = [
        feature.package_install(subjects = ["systemd"]),
        feature.ensure_file_symlink(
            link = "/usr/bin/systemctl.link",
            target = "/usr/bin/systemctl",
        ),
    ],
)

image.layer(
    name = "binary-clone",
    features = [
        feature.ensure_dirs_exist(dirs = "/usr/bin"),
        feature.clone(
            path = "/usr/bin/systemctl",
            src_layer = ":binaries-clone-src",
        ),
    ],
    parent_layer = ":base",
)

image_sh_test(
    name = "binary-clone-fails",
    layer = ":binary-clone",
    test = "test-binary-clone-fails.sh",
)

image.layer(
    name = "extract-layer",
    features = [
        feature.ensure_dirs_exist(dirs = "/usr/bin"),
        feature.extract_from_layer(
            binaries = [
                "/usr/bin/systemctl",
            ],
            layer = ":binaries-clone-src",
        ),
        feature.extract_from_layer(
            binaries = [
                # This binary extract overlaps with a subset of
                # files extracted above.
                library_path("libc.so.6"),
            ],
            layer = ":binaries-clone-src",
        ),
    ],
    parent_layer = ":base",
)

image_sh_test(
    name = "extract-layer-test",
    layer = ":extract-layer",
    test = "test-extract-layer.sh",
)

image.layer(
    name = "extract-symlink-layer",
    features = [
        feature.ensure_dirs_exist(dirs = "/usr/bin"),
        feature.extract_from_layer(
            binaries = [
                "/usr/bin/systemctl.link",
            ],
            layer = ":binaries-clone-src",
        ),
        feature.extract_from_layer(
            binaries = [
                # This symlink extract overlaps with a subset of
                # files extracted above.
                library_path("libsystemd.so.0"),
            ],
            layer = ":binaries-clone-src",
        ),
    ],
    parent_layer = ":base",
)

image_sh_test(
    name = "extract-symlink-layer-test",
    layer = ":extract-symlink-layer",
    test = "test-extract-symlink-layer.sh",
)

image.layer(
    name = "sudo-src",
    features = [
        feature.package_install(subjects = ["sudo"]),
        # Ubuntu selects sudo-rs by default. Keep this fixture on the C sudo
        # binary to test extracting its plugin and execute-only setuid mode.
        select({
            "//antlir/antlir2/os/family:family[debian]": feature.genrule(
                bash = """
                    if test -f /usr/bin/sudo.ws; then
                        rm /usr/bin/sudo
                        cp /usr/bin/sudo.ws /usr/bin/sudo
                    fi
                    chmod 4111 /usr/bin/sudo
                """,
                user = "root",
            ),
            "DEFAULT": [],
        }),
    ],
)

image.layer(
    name = "extract-sudo",
    features = [
        feature.ensure_dirs_exist(dirs = "/usr/bin"),
        feature.ensure_dirs_exist(dirs = "/usr/libexec/sudo"),
        feature.extract_from_layer(
            binaries = [
                # /usr/bin/sudo is mode 4111 (setuid, execute-only),
                # which cannot be opened O_RDONLY by an unprivileged user.
                "/usr/bin/sudo",
            ],
            layer = ":sudo-src",
        ),
        feature.extract_from_layer(
            binaries = [
                # sudo loads this plugin via dlopen, so it is not picked up
                # as an ELF dependency of /usr/bin/sudo itself.
                "/usr/libexec/sudo/sudoers.so",
            ],
            layer = ":sudo-src",
        ),
        # the sudoers plugin refuses to initialize without this
        feature.clone(
            path = "/etc/sudoers",
            src_layer = ":sudo-src",
        ),
    ],
    parent_layer = ":base",
)

image_sh_test(
    name = "extract-sudo-test",
    layer = ":extract-sudo",
    test = "test-extract-sudo.sh",
)
