load("//antlir/antlir2/features:defs.bzl", "feature_impl")
load("//antlir/bzl:build_defs.bzl", "rust_binary")
load(":hermetic.bzl", "hermetic_driver")

oncall("antlir")

feature_impl(
    name = "rpm",
    deps = [
        "anyhow",
        "memfd",
        "serde_json",
        "tempfile",
        "//antlir/antlir2/antlir2_isolate:antlir2_isolate",
        "//antlir/buck2/buck_label:buck_label",
        "//antlir/util/cli/json_arg:json_arg",
    ],
)

rust_binary(
    name = "plan",
    srcs = ["plan.rs"],
    visibility = ["PUBLIC"],
    deps = [
        "anyhow",
        "clap",
        "serde_json",
        "tracing",
        "tracing-subscriber",
        ":rpm.lib",
        "//antlir/antlir2/antlir2_compile:antlir2_compile",
        "//antlir/antlir2/antlir2_isolate:antlir2_isolate",
        "//antlir/antlir2/antlir2_rootless:antlir2_rootless",
        "//antlir/buck2/buck_label:buck_label",
        "//antlir/util/cli/json_arg:json_arg",
    ],
)

prelude = native

_source_date_epoch = read_config("antlir2", "source_date_epoch", "")

# Every rpm feature, including the implicit ones from feature.install, runs
# this driver. With hermetic RPM installs enabled (the
# antlir//antlir/antlir2/cfg:hermetic_rpm[enabled] modifier) the dnf
# transaction runs under Hermit; otherwise it is the plain python driver,
# unchanged.
prelude.alias(
    name = "driver",
    actual = select({
        "DEFAULT": ":dnf-driver",
        "antlir//antlir/antlir2/cfg:hermetic_rpm[enabled]": ":hermetic-driver",
    }),
    visibility = ["PUBLIC"],
)

hermetic_driver(
    name = "hermetic-driver",
    driver = ":dnf-driver",
    # @oss-disable[end= ]: hermit = "fbcode//hermetic_infra/hermit/hermit-cli:hermit",
    # Required when hermetic RPM installs are enabled: the commit time of the
    # revision being built, in seconds since the epoch. See hermetic.bzl.
    source_date_epoch = int(_source_date_epoch) if _source_date_epoch.isdigit() else None,
    # Only meaningful, and only analyzable (it needs the epoch), when hermetic
    # RPM installs are enabled; plain builds of this package skip it.
    target_compatible_with = select({
        "DEFAULT": ["ovr_config//:none"],
        "antlir//antlir/antlir2/cfg:hermetic_rpm[enabled]": ["ovr_config//cpu:x86_64"],
    }),
    wrapper = "hermetic_driver.sh",
)

prelude.python_bootstrap_binary(
    name = "dnf-driver",
    main = "driver.py",
    deps = [
        ":antlir2_features_rpm_common",
        "//antlir/antlir2/package_managers/dnf/build_appliance:antlir2_dnf_base",
    ],
)

prelude.python_bootstrap_library(
    name = "antlir2_features_rpm_common",
    srcs = ["antlir2_features_rpm_common.py"],
)

prelude.python_bootstrap_binary(
    name = "resolve",
    main = "resolve.py",
    visibility = ["PUBLIC"],
    deps = [
        ":antlir2_features_rpm_common",
        "//antlir/antlir2/package_managers/dnf/build_appliance:antlir2_dnf_base",
    ],
)
