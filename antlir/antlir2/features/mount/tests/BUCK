load("//antlir/antlir2/bzl/feature:defs.bzl", "feature")
load("//antlir/antlir2/bzl/image:defs.bzl", "image")
load("//antlir/antlir2/testing:image_test.bzl", "image_sh_test")

oncall("antlir")

image.layer(
    name = "src",
    features = [
        feature.install(
            src = "//antlir:empty",
            dst = "/empty",
            mode = "a+rx",
        ),
    ],
)

image.layer(
    name = "parent",
    features = [
        feature.rpms_install(
            rpms = [
                "bash",
                "coreutils",
                "util-linux",
            ]
        ),
        feature.ensure_dirs_exist(dirs = "/mount/in"),
        feature.layer_mount(
            mountpoint = "/mount/in/parent",
            source = ":src",
        ),
    ],
)

image.layer(
    name = "mount",
    features = [
        feature.layer_mount(
            mountpoint = "/mount/in/child",
            source = ":parent",
        ),
    ],
    parent_layer = ":parent",
)

image_sh_test(
    name = "mount-test",
    layer = ":mount",
    test = "test-mount.sh",
)

# The same layers built in cad-stack format on remote execution: the test
# materializes the mounted layers itself
image.layer(
    name = "mount-cad-stack",
    features = [
        feature.layer_mount(
            mountpoint = "/mount/in/child",
            source = ":parent",
        ),
    ],
    parent_layer = ":parent",
    rootless = True,
    working_format = "cad-stack",
)

image_sh_test(
    name = "mount-test-cad-stack-remote",
    exec_mode = "force-remote",
    layer = ":mount-cad-stack",
    rootless = True,
    test = "test-mount.sh",
)
