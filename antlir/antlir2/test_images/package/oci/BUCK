# @oss-disable[end= ]: load("@fbsource//tools/target_determinator/macros:ci.bzl", "ci")
load("//antlir/antlir2/bzl/feature:defs.bzl", "feature")
load("//antlir/antlir2/bzl/image:defs.bzl", "image")
load("//antlir/antlir2/bzl/package:oci.bzl", "oci")
load("//antlir/antlir2/features/oci:oci.bzl", "oci_features")
load("//antlir/antlir2/testing:image_test.bzl", "image_python_test")
load("//antlir/bzl:build_defs.bzl", "python_library")

oncall("antlir")

python_library(
    name = "podman_helpers",
    srcs = ["podman_helpers.py"],
)

image.layer(
    name = "base",
    features = [
        feature.rpms_install(rpms = ["coreutils"]),
        feature.install_text(
            dst = "/to-be-deleted",
            text = "to-be-deleted",
        ),
        feature.install_text(
            dst = "/to-be-deleted-and-recreated",
            text = "to-be-deleted-and-recreated",
        ),
        oci_features.label(
            key = "com.meta.test.label",
            value = "test-value",
        ),
        oci_features.env(
            key = "HHVM_DISABLE_PERSONALITY",
            value = "1",
        ),
    ],
)

image.layer(
    name = "intermediate",
    features = [
        feature.remove(path = "/to-be-deleted-and-recreated"),
    ],
    parent_layer = ":base",
)

image.layer(
    name = "layer",
    features = [
        # make sure that RPM installations can be layered
        feature.rpms_install(rpms = ["bash"]),
        feature.remove(path = "/to-be-deleted"),
        feature.install_text(
            dst = "/to-be-deleted-and-recreated",
            text = "recreated\n",
        ),
        feature.install_text(
            dst = "/entrypoint.sh",
            mode = "a+rx",
            text = """#!/bin/bash
if [ "$1" != "foo" ]; then
    echo "Expected $1=foo"
fi
echo "Entrypoint!"
stat --format="%a %u %g" /entrypoint.sh
stat /to-be-deleted 2>&1 || true
cat /to-be-deleted-and-recreated
""",
        ),
        oci_features.label(
            key = "com.meta.test.another",
            value = "another-value",
        ),
        oci_features.env(
            key = "TEST_ENV_VAR",
            value = "test-value",
        ),
    ],
    parent_layer = ":intermediate",
)

oci(
    name = "oci",
    entrypoint = [
        "/entrypoint.sh",
        "foo",
    ],
    layer = ":layer",
)

image.layer(
    name = "test-layer",
    features = [
        feature.rpms_install(rpms = [
            "podman",
            "python3",
        ]),
    ],
)

image_python_test(
    name = "test",
    srcs = ["test.py"],
    env = {
        "OCI": "$(location :oci)",
    },
    # This test does not work under architecture emulation. Mark it as such in
    # buck-land, and also disable scheduling CI for aarch64
    exec_compatible_with = select({
        "ovr_config//cpu:arm64": ["ovr_config//cpu:arm64"],
        "ovr_config//cpu:x86_64": ["ovr_config//cpu:x86_64"],
    }),
    # @oss-disable[end= ]: labels = ci.labels(ci.remove(ci.aarch64())),
    layer = ":test-layer",
    deps = [":podman_helpers"],
)

# Test collapse_into_one_layer: package the same layer as a single collapsed
# layer and verify the container still runs correctly.

oci(
    name = "oci-collapse",
    collapse_into_one_layer = True,
    entrypoint = [
        "/entrypoint.sh",
        "foo",
    ],
    layer = ":layer",
)

image_python_test(
    name = "test-collapse",
    srcs = ["test.py"],
    env = {
        "OCI": "$(location :oci-collapse)",
    },
    exec_compatible_with = select({
        "ovr_config//cpu:arm64": ["ovr_config//cpu:arm64"],
        "ovr_config//cpu:x86_64": ["ovr_config//cpu:x86_64"],
    }),
    # @oss-disable[end= ]: labels = ci.labels(ci.remove(ci.aarch64())),
    layer = ":test-layer",
    deps = [":podman_helpers"],
)

oci(
    name = "oci-zstd-chunked",
    entrypoint = [
        "/entrypoint.sh",
        "foo",
    ],
    layer = ":layer",
    zstd_chunked = True,
)

image_python_test(
    name = "test-zstd-chunked",
    srcs = ["test_zstd_chunked.py"],
    env = {
        "OCI": "$(location :oci-zstd-chunked)",
    },
    exec_compatible_with = select({
        "ovr_config//cpu:arm64": ["ovr_config//cpu:arm64"],
        "ovr_config//cpu:x86_64": ["ovr_config//cpu:x86_64"],
    }),
    # @oss-disable[end= ]: labels = ci.labels(ci.remove(ci.aarch64())),
    layer = ":test-layer",
    deps = [":podman_helpers"],
)

# Test strip_paths and retain_paths filtering

image.layer(
    name = "filter-layer",
    features = [
        feature.rpms_install(rpms = ["bash"]),
        feature.install_text(
            dst = "/kept-file",
            text = "this file is kept\n",
        ),
        feature.install_text(
            dst = "/ignored-file",
            text = "this file is ignored\n",
        ),
        feature.ensure_dirs_exist(dirs = "/ignored-dir"),
        feature.install_text(
            dst = "/ignored-dir/nested",
            text = "nested in ignored dir\n",
        ),
        feature.install_text(
            dst = "/entrypoint.sh",
            mode = "a+rx",
            text = """#!/bin/bash
echo "filter-test"
""",
        ),
    ],
)

oci(
    name = "oci-strip-paths",
    entrypoint = ["/entrypoint.sh"],
    layer = ":filter-layer",
    strip_paths = [
        "^/ignored-file$",
        "^/ignored-dir",
    ],
)

oci(
    name = "oci-retain-paths",
    entrypoint = ["/entrypoint.sh"],
    layer = ":filter-layer",
    retain_paths = [
        "^/entrypoint\\.sh$",
        "^/kept-file$",
        "^/usr",
        "^/lib",
        "^/bin",
        "^/sbin",
        "^/etc",
        "^/var",
    ],
)

image.layer(
    name = "strip-whiteout-base",
    features = [
        feature.rpms_install(rpms = ["bash"]),
        feature.ensure_dirs_exist(dirs = "/wh-test-dir"),
        feature.install_text(
            dst = "/wh-test-dir/removed-file",
            text = "will be removed in child layer\n",
        ),
        feature.install_text(
            dst = "/wh-test-dir/kept-file",
            text = "stays\n",
        ),
        feature.ensure_dirs_exist(dirs = "/wh-deleted-dir"),
        feature.install_text(
            dst = "/wh-deleted-dir/file",
            text = "parent dir deleted\n",
        ),
        feature.install_text(
            dst = "/entrypoint.sh",
            mode = "a+rx",
            text = """#!/bin/bash
echo "wh-test"
""",
        ),
    ],
)

image.layer(
    name = "strip-whiteout-child",
    features = [
        feature.remove(path = "/wh-test-dir/removed-file"),
        feature.remove(path = "/wh-deleted-dir"),
    ],
    parent_layer = ":strip-whiteout-base",
)

oci(
    name = "oci-strip-whiteout",
    entrypoint = ["/entrypoint.sh"],
    layer = ":strip-whiteout-child",
    strip_paths = [
        "^/wh-test-dir/removed-file$",
    ],
)

image_python_test(
    name = "test-path-filtering",
    srcs = ["test_path_filtering.py"],
    env = {
        "OCI_RETAIN": "$(location :oci-retain-paths)",
        "OCI_STRIP": "$(location :oci-strip-paths)",
        "OCI_STRIP_WHITEOUT": "$(location :oci-strip-whiteout)",
    },
    exec_compatible_with = select({
        "ovr_config//cpu:arm64": ["ovr_config//cpu:arm64"],
        "ovr_config//cpu:x86_64": ["ovr_config//cpu:x86_64"],
    }),
    # @oss-disable[end= ]: labels = ci.labels(ci.remove(ci.aarch64())),
    layer = ":test-layer",
    deps = [":podman_helpers"],
)

# Test OCI prebuilt roundtrip: import an OCI image via image.prebuilt, add a
# layer on top, then re-package. The base OCI archive's layers and metadata
# should be preserved byte-for-byte.

image.prebuilt(
    name = "oci-prebuilt-import",
    src = ":oci",
    format = "oci",
)

image.layer(
    name = "prebuilt-addon-layer",
    features = [
        feature.install_text(
            dst = "/prebuilt-test-marker",
            text = "roundtrip-success\n",
        ),
    ],
    parent_layer = ":oci-prebuilt-import",
)

oci(
    name = "oci-from-prebuilt",
    entrypoint = [
        "/entrypoint.sh",
        "foo",
    ],
    layer = ":prebuilt-addon-layer",
)

image_python_test(
    name = "test-prebuilt",
    srcs = ["test_prebuilt.py"],
    env = {
        "OCI_FROM_PREBUILT": "$(location :oci-from-prebuilt)",
        "OCI_ORIGINAL": "$(location :oci)",
    },
    exec_compatible_with = select({
        "ovr_config//cpu:arm64": ["ovr_config//cpu:arm64"],
        "ovr_config//cpu:x86_64": ["ovr_config//cpu:x86_64"],
    }),
    # @oss-disable[end= ]: labels = ci.labels(ci.remove(ci.aarch64())),
    layer = ":test-layer",
    deps = [":podman_helpers"],
)
