load("//antlir/antlir2/bzl/feature:defs.bzl", "feature")
load("//antlir/antlir2/bzl/image:defs.bzl", "image")
load("//antlir/antlir2/bzl/package:defs.bzl", "package")
load("//antlir/antlir2/testing:image_test.bzl", "image_python_test")
load("//antlir/bzl:build_defs.bzl", "cpp_binary", "cpp_library", "python_binary")
load("//antlir/bzl:internal_external.bzl", "internal_external")

oncall("antlir")

cpp_library(
    # @autodeps-skip
    name = "libadd",
    srcs = ["add.c"],
    # the "main" SONAME is like a major version, there may be another point
    # release tacked on but anything with the same SONAME can be considered
    # fungible
    soname = "libadd.so.1",
)

cpp_binary(
    # @autodeps-skip
    name = "add",
    deps = [":libadd"],
)

image.layer(
    name = "layer",
    features = [
        feature.ensure_dirs_exist(dirs = "/usr/bin"),
        feature.install(
            src = ":add",
            dst = "/usr/bin/add",
            never_use_dev_binary_symlink = True,
        ),
        feature.ensure_dirs_exist(dirs = "/usr/lib64"),
        feature.install(
            src = ":libadd[shared]",
            # Install at a more specific version path, then ldconfig will
            # symlink libadd.so.1 (SONAME) to this path during rpmbuild
            dst = "/usr/lib64/libadd.so.1.2",
        ),
        feature.ensure_dirs_exist(dirs = "/dir/with space"),
        feature.install_text(
            dst = "/dir/with space/hello world.txt",
            text = "File with space in dir with space\n",
        ),
    ],
)

package.rpm(
    name = "add.rpm",
    # @oss-disable[end= ]: compatible_with = ["ovr_config//build_mode:opt"],
    dirs = ["/dir/with space"],
    disable_ldconfig = True,
    layer = ":layer",
    license = "none",
    rpm_name = "add",
)

python_binary(
    name = "outplace",
    srcs = ["outplace.py"],
    main_module = "antlir.antlir2.test_images.package.rpm.outplace",
    package_style = "outplace",
)

image.layer(
    name = "outplace-layer",
    features = [
        feature.ensure_dirs_exist(dirs = "/usr/local"),
        feature.install(
            src = ":outplace",
            dst = "/usr/bin/outplace",
        ),
    ],
    # /usr/bin/add would otherwise get a build-id link, as it does in add.rpm
    parent_layer = ":layer",
)

package.rpm(
    name = "outplace.rpm",
    # @oss-disable[end= ]: compatible_with = ["ovr_config//build_mode:opt"],
    disable_ldconfig = True,
    layer = ":outplace-layer",
    license = "none",
    rpm_name = "outplace",
)

tcw = select(
    internal_external(
        fb = {
            "DEFAULT": ["ovr_config//:none"],
            "ovr_config//build_mode:opt": [],
        },
        oss = {
            "DEFAULT": ["ovr_config//:none"],
        },
    )
)

image.layer(
    name = "test-layer",
    features = [
        feature.rpms_install(rpms = ["rpm"]),
        feature.install(
            src = ":add.rpm",
            dst = "/add.rpm",
        ),
        feature.install(
            src = ":outplace.rpm",
            dst = "/outplace.rpm",
        ),
    ],
    target_compatible_with = tcw,
)

image_python_test(
    name = "test",
    srcs = ["test.py"],
    layer = ":test-layer",
    target_compatible_with = tcw,
)
