load("//antlir/antlir2/bzl/feature:defs.bzl", "feature")
load("//antlir/antlir2/bzl/image:defs.bzl", "image")
load("//antlir/antlir2/bzl/package:defs.bzl", "package")
load("//antlir/antlir2/facebook/images/build_appliance:defs.bzl", "build_appliance_from_dir")
load("//antlir/bzl:build_defs.bzl", "alias", "rust_binary")
load("//antlir/bzl:internal_external.bzl", "internal_external")

oncall("antlir")

rust_binary(
    name = "antlir2-packager",
    srcs = glob(["src/**/*.rs"]),
    compatible_with = [
        "ovr_config//os:linux",
    ],
    features = select({
        "//antlir/antlir2/libcap:available": ["libcap"],
        "DEFAULT": [],
    }),
    visibility = ["PUBLIC"],
    deps = [
        "anyhow",
        "base64",
        "blake3",
        "bytesize",
        "cap-std",
        "chrono",
        "clap",
        "crc32c-hw",
        "gpt",
        "hex",
        "itertools",
        "maplit",
        "nix",
        "oci-spec",
        "retry",
        "serde",
        "serde_json",
        "sha2-010",
        "tempfile",
        "tracing",
        "tracing-subscriber",
        "uuid",
        "walkdir",
        "xattr",
        "//antlir/antlir2/antlir2_btrfs:antlir2_btrfs",
        "//antlir/antlir2/antlir2_facts:antlir2_facts",
        "//antlir/antlir2/antlir2_isolate:antlir2_isolate",
        "//antlir/antlir2/antlir2_path:antlir2_path",
        "//antlir/antlir2/antlir2_rootless:antlir2_rootless",
        "//antlir/antlir2/antlir2_working_volume:antlir2_working_volume",
        "//antlir/antlir2/cad_stack:cad_stack",
        "//antlir/antlir2/cad_stack/cad_stack_fs:cad_stack_fs",
        "//antlir/util/cli/json_arg:json_arg",
    ] + select({
        "//antlir/antlir2/libcap:available": ["//antlir/antlir2/libcap:libcap"],
        "DEFAULT": [],
    }),
)

feature.new(
    name = "build-appliance-features",
    features = [
        feature.package_install(
            subjects = [
                "cpio",
                "dosfstools",
                "e2fsprogs",
                "mtools",
                "skopeo",
                "squashfs-tools",
                "zstd",
            ]
        ),
        select({
            "//antlir/antlir2/os/package_manager:package_manager[apt]": feature.apt_install(
                packages = [
                    "dpkg-dev",
                    "erofs-utils",
                ]
            ),
            "DEFAULT": feature.rpms_install(
                rpms = [
                    "rpm-build",
                    "rpm-sign",
                ]
            ),
        }),
        ":erofs-utils",
        ":btrfs-progs",
    ],
    visibility = [],
)

# el9 only ever shipped erofs-utils 1.7.1, whose buffer-block allocator is
# quadratic in image size: placing a file's inlined tail scans every metadata
# block allocated so far looking for one with room. Upstream fixed it in v1.8.6
# by indexing those blocks by free space (erofs-utils commits a42dc09 +
# d97c001), which took their 1.28M-inode uncompressed benchmark from 36m29s to
# 1m14s at the same image size. Build from third-party so we get the fix
# without waiting on an el9 rebuild.
feature.new(
    name = "erofs-utils",
    features = internal_external(
        # Same platform matrix as the OSS branch below, so this is only a swap
        # of which mkfs.erofs gets installed -- never a change to *where* one
        # is available. apt platforms already get erofs-utils from the
        # apt_install above, and el8 has no erofs-utils at all.
        fb = [
            select({
                "//antlir/antlir2/os/package_manager:package_manager[apt]": None,
                "//antlir/antlir2/os:centos8": None,
                "//antlir/antlir2/os:rhel8": None,
                "//antlir/antlir2/os:rhel8.8": None,
                "DEFAULT": [
                    feature.ensure_dirs_exist(dirs = "/usr/local/bin"),
                    feature.install(
                        src = "fbsource//third-party/erofs-utils:mkfs.erofs",
                        dst = "/usr/local/bin/mkfs.erofs",
                    ),
                ],
            }),
        ],
        oss = [
            select({
                "//antlir/antlir2/os/package_manager:package_manager[apt]": None,
                "//antlir/antlir2/os:centos8": None,
                "//antlir/antlir2/os:rhel8": None,
                "//antlir/antlir2/os:rhel8.8": None,
                "DEFAULT": feature.rpms_install(
                    rpms = [
                        "erofs-utils",
                    ]
                ),
            }),
        ],
    ),
    visibility = [],
)

feature.new(
    name = "btrfs-progs",
    features = internal_external(
        fb = [
            feature.ensure_dirs_exist(dirs = "/usr/local/bin"),
            feature.install(
                src = "fbsource//third-party/btrfs-progs:btrfs",
                dst = "/usr/local/bin/btrfs",
            ),
            feature.install(
                src = "fbsource//third-party/btrfs-progs:btrfstune",
                dst = "/usr/local/bin/btrfstune",
            ),
            feature.install(
                src = "fbsource//third-party/btrfs-progs:mkfs.btrfs",
                dst = "/usr/local/bin/mkfs.btrfs",
            ),
        ],
        oss = [feature.package_install(subjects = ["btrfs-progs"])],
    ),
    visibility = [],
)

image.layer(
    name = "packager-appliance.layer",
    default_os = "centos10",
    features = [
        ":build-appliance-features",
    ],
    visibility = [],
)

package.unprivileged_dir(
    name = "packager-appliance.dir",
    default_os = "centos10",
    layer = ":packager-appliance.layer",
    visibility = ["//antlir/antlir2/antlir2_packager/facebook/..."],
)

build_appliance_from_dir(
    name = "packager-appliance.impl",
    dir = ":packager-appliance.dir",
    visibility = ["PUBLIC"],
)

alias(
    name = "packager-appliance",
    actual = internal_external(
        fb = "//antlir/antlir2/antlir2_packager/facebook:msdk-packager-appliance",
        oss = ":packager-appliance.impl",
    ),
    visibility = ["PUBLIC"],
)
