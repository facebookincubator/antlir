load("//antlir/bzl:internal_external.bzl", "internal_external")
load(":bootstrap.bzl", "BOOTSTRAP_PACKAGES", "bootstrap")
load(":suite.bzl", "suite")

oncall("antlir")

prelude = native

prelude.python_bootstrap_binary(
    name = "local-suite-index",
    main = "local_suite_index.py",
    visibility = ["PUBLIC"],
)

suite(
    name = "trixie",
    architectures = [
        "amd64",
        "arm64",
    ],
    archive_url = internal_external(
        fb = "https://mirror.facebook.net/debian",
        oss = "https://deb.debian.org/debian",
    ),
    components = [
        "main",
        "contrib",
    ],
    package_aliases_subtargets = BOOTSTRAP_PACKAGES,
    snapshot_storage = {
        "api_key": "antlir_snapshots-key",
        "bucket": "antlir_snapshots",
        "type": "manifold",
    },
    visibility = ["PUBLIC"],
)

suite(
    name = "noble",
    architectures = [
        "amd64",
        # Noble does not have aarch64 packages
    ],
    archive_url = internal_external(
        fb = "https://mirror.facebook.net/ubuntu",
        oss = "https://archive.ubuntu.com/ubuntu",
    ),
    components = [
        "main",
        "universe",
    ],
    distribution = "noble",
    snapshot_storage = {
        "api_key": "antlir_snapshots-key",
        "bucket": "antlir_snapshots",
        "type": "manifold",
    },
    visibility = ["PUBLIC"],
)

suite(
    name = "stonking",
    architectures = [
        "amd64",
        "arm64",
    ],
    archive_url = internal_external(
        fb = "https://mirror.facebook.net/ubuntu",
        oss = "https://archive.ubuntu.com/ubuntu",
    ),
    components = [
        "main",
        "universe",
    ],
    distribution = "stonking",
    snapshot_storage = {
        "api_key": "antlir_snapshots-key",
        "bucket": "antlir_snapshots",
        "type": "manifold",
    },
    visibility = ["PUBLIC"],
)

bootstrap(
    name = "build-appliance",
    debs = [":trixie[package_aliases_subtargets][{}.deb]".format(pkg) for pkg in BOOTSTRAP_PACKAGES],
    visibility = ["PUBLIC"],
)
