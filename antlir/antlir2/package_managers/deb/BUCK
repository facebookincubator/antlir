    # stack that keep it hardcoded
    inrelease_checksums = {
        "sha1": "ca4c891ee6114d2a800cc3b2675a36847ecc1da8",
        "sha256": "7592e4ccb4658a58bfe485d3356b3c983bf8ccff7fca1f6091e4d4296284ed18",
    },
    visibility = ["PUBLIC"],
)
