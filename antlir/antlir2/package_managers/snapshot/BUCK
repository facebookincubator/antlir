load("@prelude//:rules.bzl", "constraint")
load("//antlir/bzl:build_defs.bzl", "alias", "rust_binary", "rust_library")
load("//antlir/bzl:internal_external.bzl", "internal_external")

oncall("antlir")

# Build `snapshot` and `metadata` from the sources in this package instead
# of downloading the prebuilt MSDK binaries (the default). Pass the modifier
# to any build that (transitively) depends on them, e.g.:
#   buck2 build fbcode//antlir/antlir2/package_managers/snapshot:snapshot \
#       -m 'antlir//antlir/antlir2/package_managers/snapshot:build-mode[from-source]'
constraint(
    name = "build-mode",
    default = "msdk",
    values = [
        "msdk",
        "from-source",
    ],
    visibility = ["PUBLIC"],
)

rust_library(
    name = "snapshot_common",
    srcs = glob(["common/src/**/*.rs"]),
    crate_root = "common/src/lib.rs",
    test_deps = [
        "hex-literal",
        "serde_json",
        "serde_starlark",
    ],
    deps = [
        "anyhow",
        "bon",
        "cap-std",
        "hex",
        "serde",
        "serde_with",
        "sha1-010",
        "sha2-010",
        "thiserror",
        "tokio",
    ],
)

rust_binary(
    name = "metadata.real",
    srcs = glob(["metadata/src/**/*.rs"]),
    crate = "metadata",
    crate_root = "metadata/src/main.rs",
    test_deps = [
        "hex-literal",
    ],
    test_srcs = glob(["testdata/**"]),
    visibility = [],
    deps = [
        "anyhow",
        "clap",
        "flate2",
        "hex",
        "liblzma",
        "quick-xml",
        "serde",
        "serde_json",
        "serde_with",
        "tracing",
        "tracing-subscriber",
        ":snapshot_common",
        "//antlir/filesystem/stdio_path:stdio_path",
        "//antlir/util/cli/json_arg:json_arg",
    ],
)

alias(
    name = "metadata",
    actual = select({
        ":build-mode[from-source]": ":metadata.real",
        ":build-mode[msdk]": internal_external(
            fb = "//antlir/antlir2/package_managers/snapshot/facebook:msdk[metadata/metadata]",
            oss = ":metadata.real",
        ),
    }),
    visibility = ["PUBLIC"],
)

rust_binary(
    name = "snapshot.real",
    srcs = glob(["snapshot/src/**/*.rs"]),
    crate = "snapshot",
    crate_root = "snapshot/src/main.rs",
    fb_deps = [
        "governor",
        "//manifold/clients/rust:manifold_client",
    ],
    link_style = select({
        "DEFAULT": "static",
        # @oss-disable[end= ]: "ovr_config//build_mode/constraints:dev": "shared",
    }),
    test_deps = [
        "hex-literal",
    ],
    visibility = [],
    deps = [
        "anyhow",
        "async-trait",
        "backoff",
        "cap-std",
        "chrono",
        "clap",
        "fbinit",
        "fbinit-tokio",
        "futures",
        "hex",
        "indicatif",
        "parking_lot",
        "reqwest",
        "serde",
        "serde_json",
        "tempfile",
        "thiserror",
        "tokio",
        "tracing",
        "tracing-subscriber",
        "typetag",
        "url",
        ":snapshot_common",
        "//antlir:find_root",
        "//antlir/buck2/buck_label:buck_label",
        "//antlir/buck2/buck_targets:buck_targets",
        "//antlir/filesystem/stdio_path:stdio_path",
        "//antlir/util/cli/json_arg:json_arg",
    ],
)

alias(
    name = "snapshot",
    actual = select({
        ":build-mode[from-source]": ":snapshot.real",
        ":build-mode[msdk]": internal_external(
            fb = "//antlir/antlir2/package_managers/snapshot/facebook:msdk[snapshot/snapshot]",
            oss = ":snapshot.real",
        ),
    }),
    visibility = ["PUBLIC"],
)
