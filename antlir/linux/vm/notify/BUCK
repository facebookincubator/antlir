load("//antlir/antlir2/bzl/feature:defs.bzl", "feature")
load("//antlir/bzl:systemd.bzl", "systemd")

oncall("antlir")

# Install the necessary configuration to notify the `antlir.vm` runtime when a
# host has booted.
feature.new(
    name = "notify",
    features = [
        feature.ensure_dirs_exist(dirs = "/usr/lib/antlir"),
        feature.install(
            src = "vm-notify-ready",
            dst = "/usr/lib/antlir/vm-notify-ready",
            mode = "a+rx",
        ),
        systemd.install_unit(
            "virtio-notify@.service",
        ),
        # Enable using the virtio socket named "notify-host"
        systemd.enable_unit(
            "virtio-notify@notify-host.service",
        ),
    ],
    visibility = ["PUBLIC"],
)
