load("//antlir/buck2/buck_targets:macros.bzl", "macro_expanded_label")
load(":defs.bzl", "my_rule")

oncall("antlir")

my_rule(
    name = "alpha",
    srcs = ["alpha.rs"],
    deps = select({
        "ovr_config//cpu:arm64": ["//a:a"],
        "ovr_config//cpu:x86_64": ["//x:x"],
    }),
)

my_rule(
    name = "beta",
    srcs = ["beta.rs"],
    deps = select({
        "DEFAULT": ["//d:d"],
        "antlir//antlir/antlir2/os:centos10": ["//c:c"],
    }),
)

# Auxiliary target as if generated by a macro expansion: it carries the
# macro-expanded label and must be SKIPPED by the dumper, so the round-trip
# yields only the two top-level targets above.
my_rule(
    name = "gamma",
    srcs = ["gamma.rs"],
    labels = [macro_expanded_label("my_rule")],
)
