load("@prelude//platforms:defs.bzl", "execution_platform", "host_configuration")
load(":local.bzl", "local_configuration")

oncall("antlir_oss")

local_configuration(
    name = "local-os",
    constraints = [
        "prelude//platforms:may_run_local",
        "prelude//platforms:runs_only_local",
    ],
    os = host_configuration.os,
)

execution_platform(
    name = "host",
    cpu_configuration = host_configuration.cpu,
    os_configuration = ":local-os",
    use_windows_path_separators = host_info().os.is_windows,
    visibility = ["PUBLIC"],
)
